<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>assets\hoco-keepalive.ico</ApplicationIcon>
    <AssemblyName>HOCO KeepAlive</AssemblyName>
    <RootNamespace>HocoKeepAlive</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Description>Silent Bluetooth audio keep-alive utility</Description>
    <Company>Raiyan</Company>
    <Product>HOCO KeepAlive</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test sources must be compiled only by the test project, not the application. -->
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets\hoco-keepalive.ico" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>
</Project>